{
  "name": "dsh-plugin-dot",
  "version": "1.3.0",
  "description": "Dot for DeepSeek Harness: a personal chief-of-staff agent preset with long-term memory, a task list with auto reminders, instant slash commands, allow/ask/block rules and an on-screen pet that reports status. · DSH 个人总管：记忆、事务与自动提醒、零模型快捷指令、自定义规则、桌面小精灵。",
  "type": "module",
  "main": "./lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./agent": "./lib/index.js",
    "./commands": "./lib/commands.js",
    "./host": "./lib/host.js",
    "./client": "./lib/bridge.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis-plugin",
    "agent",
    "assistant",
    "memory",
    "chief-of-staff"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.0 <0.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h958661134/dsh-plugin-dot.git"
  },
  "homepage": "https://github.com/h958661134/dsh-plugin-dot#readme",
  "bugs": "https://github.com/h958661134/dsh-plugin-dot/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
